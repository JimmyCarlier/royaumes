# Modèle des variables d'environnement du projet.
# Copiez ce fichier en .env.local pour définir vos valeurs locales ; .env.local n'est jamais versionné.

# Base de données PostgreSQL hébergée (production, TD5).
# En local, laissez vide : PGlite est utilisé automatiquement (répertoire .data/).
DATABASE_URL=

# Secret de signature des sessions : obligatoire en production.
# Générez-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Adresse publique de l'application (http://localhost:3000 par défaut).
BETTER_AUTH_URL=

# Désactive la limitation des tentatives d'authentification, en local uniquement.
# AUTH_RATE_LIMIT=off