# Modèle des variables d'environnement du projet.
# Copiez ce fichier en .env.local pour définir vos valeurs locales ; .env.local n'est jamais versionné.

# Base de données PostgreSQL hébergée (Neon). En production, ces deux variables sont
# ajoutées automatiquement par l'intégration Neon de Vercel.
# En local, laissez-les vides : PGlite est utilisé automatiquement (répertoire .data/).
DATABASE_URL=
# Connexion directe (sans mutualisation), utilisée pour appliquer les migrations.
DATABASE_URL_UNPOOLED=

# Nombre maximal de connexions ouvertes par une instance de l'application (5 par défaut).
DB_POOL_MAX=

# Secret de signature des sessions : obligatoire en production.
# Générez-le avec : openssl rand -base64 32
BETTER_AUTH_SECRET=

# Adresse publique de l'application. Facultative : elle est déduite automatiquement
# sur Vercel, et vaut http://localhost:3000 en local.
BETTER_AUTH_URL=

# Désactive la limitation des tentatives d'authentification, en local uniquement.
# AUTH_RATE_LIMIT=off

# Secret de la tâche planifiée qui distribue la boîte d'envoi : obligatoire en production.
# Vercel l'envoie dans l'en-tête Authorization. Générez-le avec : openssl rand -base64 32
CRON_SECRET=

# Durée maximale d'un flux temps réel, en secondes (240 par défaut).
# STREAM_MAX_SECONDS=10